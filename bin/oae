#!/data/data/com.termux/files/usr/bin/bash

COMMAND=$1

case "$COMMAND" in
    doctor)
        ./workstation/doctor.sh
        ;;
    verify)
        ./workstation/verify.sh
        ;;
    update)
        ./workstation/update.sh
        ;;
    bootstrap)
        ./workstation/bootstrap.sh
        ;;
    security)
        ./workstation/security.sh
        ;;
    *)
        echo ""
        echo "Olori AI Engineer CLI"
        echo ""
        echo "Usage:"
        echo "  oae doctor"
        echo "  oae verify"
        echo "  oae update"
        echo "  oae bootstrap"
        echo "  oae security"
        ;;
esac
